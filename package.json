{
  "name": "dsh-hooks",
  "version": "0.9.1",
  "packageManager": "pnpm@11.21.0",
  "description": "Config-driven lifecycle hooks plugin for DeepSeek Harness: declare event -> command hooks in cordis.patch.yml, no plugin code required. Includes a Hooks section in the Web GUI settings (history timeline + manual tester + notify tests + hook editor + Feishu connect).",
  "author": "PeterBon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterBon/dsh-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/PeterBon/dsh-hooks/issues"
  },
  "homepage": "https://github.com/PeterBon/dsh-hooks#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "hooks",
    "automation",
    "lifecycle",
    "notification"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-hooks": "./bin/dsh-hooks.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run typecheck:test && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.0"
  }
}
