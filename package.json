{
  "name": "dsh-hooks",
  "version": "0.2.2",
  "packageManager": "pnpm@11.21.0",
  "description": "Config-driven lifecycle hooks plugin for DeepSeek Harness: declare event -> command hooks in cordis.patch.yml, no plugin code required.",
  "author": "PeterBon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterBon/dsh-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/PeterBon/dsh-hooks/issues"
  },
  "homepage": "https://github.com/PeterBon/dsh-hooks#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "hooks",
    "automation",
    "lifecycle",
    "notification"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-hooks": "./bin/dsh-hooks.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run typecheck:test && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.0"
  }
}
